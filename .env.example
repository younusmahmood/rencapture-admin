# Convex deployment shared with ../rencapture (mobile) and ../rencapture-web
# (clinic console). Same value as their CONVEX_URL / EXPO_PUBLIC_CONVEX_URL.
CONVEX_URL=https://your-deployment.convex.cloud

# Seals the httpOnly operator session cookie (AES-256 + HMAC). Must be at
# least 32 characters, and MUST be a different value than rencapture-web's
# SESSION_SECRET — if the console's secret ever leaked, operator sessions
# must not be forgeable with it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs out the (one) operator.
SESSION_SECRET=replace-me-with-a-64-char-random-hex-string
